# Copy this file to .env.local for local development (it is git-ignored).
# Both values are safe to expose in the browser: Row Level Security protects the data.
# Find them in the Supabase dashboard: Project Settings -> API Keys / Data API.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The "publishable" key (starts with sb_publishable_) or the legacy "anon" key.
# Never put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
